#!/usr/bin/env bash
# pre-commit — the gate that does not depend on anyone remembering.
#
# This repository is PUBLIC. Every rule below exists because something actually
# went wrong, or a review proved it could. A block here is a stop, not an
# obstacle: fix the staged set, or if the block is genuinely wrong, say so out
# loud before overriding.
#
# Override (deliberate, visible, and rare):  ORG_GUARD=off git commit ...
#
# Matching is case-INSENSITIVE throughout. macOS ships a case-insensitive
# filesystem, so `Local/secrets` and `local/secrets` are the same file but only
# one of them matched a case-sensitive `^local/`. Same for `.PEM` vs `.pem`.
# Every pattern here uses -i for that reason; do not "tidy" it away.

set -uo pipefail

[ "${ORG_GUARD:-on}" = "off" ] && { echo "pre-commit: DISABLED via ORG_GUARD=off"; exit 0; }

ROOT="$(git rev-parse --show-toplevel)"
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

# Content scanning deliberately skips the guard's own files. They contain the
# detector strings by definition ("PuTTY-User-Key-File", token prefixes), so
# scanning them means the hook blocks every edit to itself. The exclusion is
# narrow on purpose - only .githooks/ - and those files get read on review.
SCAN_PATHS=$(echo "$STAGED" | grep -ivE '^\.githooks/' || true)
if [ -n "$SCAN_PATHS" ]; then
  ADDED=$(echo "$SCAN_PATHS" | tr '\n' '\0' \
          | xargs -0 git diff --cached -U0 --diff-filter=ACMR -- 2>/dev/null \
          | grep '^+' | grep -v '^+++' || true)
else
  ADDED=""
fi

FAIL=0
say() { echo "  $*" >&2; }
block() { FAIL=1; echo "" >&2; echo "BLOCKED: $1" >&2; }

# 1 ── local/ is machine-only and ignored wholesale.
if echo "$STAGED" | grep -qiE '^local/'; then
  block "staged files under local/ — that directory is never pushed"
  echo "$STAGED" | grep -iE '^local/' | head -10 | while read -r f; do say "$f"; done
fi

# 2 ── Operational logs carry real client names.
LOGS='^(org/(activity|activity_addendum|decisions|company_log|status|blockers|live|risks|handoff|file_activity|agent_performance|agent_changelog)\.md|org/bugs/|review/sign_offs\.md)'
if echo "$STAGED" | grep -qiE "$LOGS"; then
  block "staged an operational log — these hold real client names"
  echo "$STAGED" | grep -iE "$LOGS" | while read -r f; do say "$f"; done
fi

# 3 ── Scaffolding at the framework root. Project work lives in
#      local/repos/<project>/; these reappearing means a mkdir -p ran from the
#      wrong root.
if echo "$STAGED" | grep -qiE '^(src|tests|ci|infra)/'; then
  block "staged files under src/, tests/, ci/ or infra/ at the framework root"
  say "Project artifacts belong in local/repos/<project>/, not here."
  echo "$STAGED" | grep -iE '^(src|tests|ci|infra)/' | head -10 | while read -r f; do say "$f"; done
fi

# 4 ── Key material and real env files, by FILENAME.
KEYFILES='(\.pem|\.key|\.p12|\.pfx|\.jks|\.keystore|\.ppk|\.asc|\.gpg|\.kdbx|id_rsa|id_dsa|id_ecdsa|id_ed25519|\.env$|\.env\.[a-z]+$|credentials\.json|service-account.*\.json)'
if echo "$STAGED" | grep -qiE "$KEYFILES"; then
  block "staged something that looks like a key, keystore or real .env"
  echo "$STAGED" | grep -iE "$KEYFILES" | while read -r f; do say "$f"; done
fi

# 5 ── Private strings in staged CONTENT. Patterns live in a gitignored file,
#      because writing client names into a public repo's hook would publish
#      exactly what the hook protects.
PATTERNS="$ROOT/local/guard-patterns.txt"
if [ -f "$PATTERNS" ] && [ -n "$ADDED" ]; then
  while IFS= read -r pat; do
    [ -z "$pat" ] && continue
    case "$pat" in \#*) continue ;; esac
    if echo "$ADDED" | grep -qiE "$pat"; then
      block "staged content matches a private pattern from local/guard-patterns.txt"
      say "pattern: $pat"
      say "Find it with: git diff --cached | grep -in '$pat'"
    fi
  done < "$PATTERNS"
fi

# 6 ── Secrets in staged CONTENT, by shape. Deliberately high-signal prefixes
#      rather than entropy heuristics: a guard that cries wolf gets switched
#      off, which is worse than no guard.
if [ -n "$ADDED" ]; then
  # PEM private key blocks, any flavour including ENCRYPTED and PKCS#8.
  if echo "$ADDED" | grep -qiE 'BEGIN ([A-Z0-9]+ )*PRIVATE KEY'; then
    block "a PRIVATE KEY block appears in the staged content"
  fi
  if echo "$ADDED" | grep -qiE 'PuTTY-User-Key-File'; then
    block "a PuTTY private key appears in the staged content"
  fi
  # Provider tokens. These prefixes are not ambiguous.
  declare -a TOKENS=(
    'ghp_[A-Za-z0-9]{20,}:GitHub personal access token'
    'gho_[A-Za-z0-9]{20,}:GitHub OAuth token'
    'ghu_[A-Za-z0-9]{20,}:GitHub user-to-server token'
    'ghs_[A-Za-z0-9]{20,}:GitHub server-to-server token'
    'ghr_[A-Za-z0-9]{20,}:GitHub refresh token'
    'github_pat_[A-Za-z0-9_]{20,}:GitHub fine-grained PAT'
    '(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}:AWS access key id'
    'sk-ant-[A-Za-z0-9_-]{20,}:Anthropic API key'
    'sk-[A-Za-z0-9]{32,}:OpenAI-style API key'
    'xox[baprs]-[A-Za-z0-9-]{10,}:Slack token'
    'AIza[A-Za-z0-9_-]{30,}:Google API key'
    'glpat-[A-Za-z0-9_-]{16,}:GitLab personal access token'
    'npm_[A-Za-z0-9]{30,}:npm access token'
    'dop_v1_[a-f0-9]{60,}:DigitalOcean token'
    'shpat_[a-fA-F0-9]{30,}:Shopify access token'
  )
  for entry in "${TOKENS[@]}"; do
    pat="${entry%%:*}"; label="${entry#*:}"
    if echo "$ADDED" | grep -qE "$pat"; then
      block "a $label appears in the staged content"
      say "Rotate it. Assume it is compromised the moment it is written down."
    fi
  done
fi

if [ "$FAIL" = "1" ]; then
  echo "" >&2
  echo "  Nothing was committed. Fix the staged set and try again." >&2
  echo "  Do not route around this gate. If it is genuinely wrong, say so first." >&2
  echo "" >&2
  exit 1
fi

exit 0
